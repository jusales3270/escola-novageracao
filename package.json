{
  "name": "somaescola",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present --filter=./packages/* run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm --filter @somaverso/schemas test && pnpm --filter @somaverso/motor test",
    "test:coverage": "pnpm --filter @somaverso/motor test:coverage",
    "lint": "pnpm -r --if-present run lint"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
