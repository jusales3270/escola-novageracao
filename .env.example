# Postgres local via docker compose — troque pelos valores da infra do
# cliente em produção sem mudar nenhum código: migrations e packages leem
# só DATABASE_URL / DATABASE_URL_MIGRATOR.
# Porta 5433 (não 5432) de propósito — máquinas de dev costumam ter outro
# Postgres/Supabase local já ocupando a 5432. Ajuste se colidir na sua máquina.
POSTGRES_DB=somaescola
POSTGRES_PORT=5433
POSTGRES_MIGRATOR_USER=soma_migrator
POSTGRES_MIGRATOR_PASSWORD=troque-em-dev-local

# Senha do papel de aplicação (soma_app), provisionado pela migration
# 0004_papel_app_e_grants.sql. Nunca comitar o valor real.
APP_DB_PASSWORD=troque-em-dev-local

# Usada por apps/api, apps/worker e packages/ledger em runtime — papel
# soma_app, restrito, SEM UPDATE/DELETE em ledger_evento.
DATABASE_URL=postgresql://soma_app:troque-em-dev-local@localhost:5433/somaescola

# Usada só pelo runner de migrations (infra/db) e pelos testes de
# integração que precisam simular adulteração/desabilitar trigger — papel
# com privilégio de DDL/CREATE ROLE (dono das tabelas).
DATABASE_URL_MIGRATOR=postgresql://soma_migrator:troque-em-dev-local@localhost:5433/somaescola

# apps/api — JWT próprio (M3, sem provedor de auth terceiro). Mínimo 32
# caracteres. Nunca comitar o valor real; gere um segredo forte em produção.
JWT_SECRET=troque-em-dev-local-com-pelo-menos-32-caracteres
# sandbox | homologacao | producao — controla R-12 (DPA) e o modo mock de assinatura futuramente (M5).
AMBIENTE=homologacao
PORT=3000
